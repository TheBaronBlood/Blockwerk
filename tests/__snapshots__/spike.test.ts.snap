exports[`SPIKE-Import: Projekte der AG > M7 Bug-Jagd - Der Block dreht immer gleich weit: vollständig übersetzt, gültiges Python 1`] = `
"from pybricks.hubs import PrimeHub
from pybricks.parameters import Direction, Port
from pybricks.pupdevices import Motor
from pybricks.robotics import DriveBase
from pybricks.tools import wait

hub = PrimeHub()

# Geräte an den Anschlüssen
motor_A = Motor(Port.A, Direction.COUNTERCLOCKWISE)
motor_B = Motor(Port.B)

# Fahrbasis
roboter = DriveBase(motor_A, motor_B, wheel_diameter=56, axle_track=112)
roboter.use_gyro(True)

def drehe(Winkel):
    hub.imu.reset_heading(0)
    roboter.drive(0, 100)
    while not (abs(hub.imu.heading()) > 88):
        wait(10)

    roboter.brake()

roboter.settings(straight_speed=100, turn_rate=100)
drehe(45)
wait(1000)
drehe(180)
"
`;

exports[`SPIKE-Import: Projekte der AG > M7 Loesung - Eigener Block drehe: vollständig übersetzt, gültiges Python 1`] = `
"from pybricks.hubs import PrimeHub
from pybricks.parameters import Direction, Port
from pybricks.pupdevices import Motor
from pybricks.robotics import DriveBase
from pybricks.tools import wait

hub = PrimeHub()

# Geräte an den Anschlüssen
motor_A = Motor(Port.A, Direction.COUNTERCLOCKWISE)
motor_B = Motor(Port.B)

# Fahrbasis
roboter = DriveBase(motor_A, motor_B, wheel_diameter=56, axle_track=112)
roboter.use_gyro(True)

def drehe(Winkel):
    hub.imu.reset_heading(0)
    roboter.drive(0, 100)
    while not (abs(hub.imu.heading()) > Winkel - 2):
        wait(10)

    roboter.brake()

roboter.settings(straight_speed=100, turn_rate=100)
for count in range(4):
    roboter.straight(200)
    drehe(90)
"
`;

exports[`SPIKE-Import: Projekte der AG > M7 Loesung - Eigener Block fahre bis Linie: vollständig übersetzt, gültiges Python 1`] = `
"from pybricks.hubs import PrimeHub
from pybricks.parameters import Color, Direction, Port
from pybricks.pupdevices import ColorSensor, Motor
from pybricks.robotics import DriveBase
from pybricks.tools import wait

hub = PrimeHub()

# Geräte an den Anschlüssen
motor_A = Motor(Port.A, Direction.COUNTERCLOCKWISE)
motor_B = Motor(Port.B)
farbe_C = ColorSensor(Port.C)
farbe_C.detectable_colors([  # mit Schwarz
    Color.RED, Color.YELLOW, Color.GREEN, Color.BLUE,
    Color.WHITE, Color.BLACK, Color.NONE,
])

# Fahrbasis
roboter = DriveBase(motor_A, motor_B, wheel_diameter=56, axle_track=112)
roboter.use_gyro(True)

def fahre_bis_Linie():
    roboter.drive(120, 0)
    while not (farbe_C.color() == Color.BLACK):
        wait(10)

    roboter.brake()

roboter.settings(straight_speed=120, turn_rate=125)
fahre_bis_Linie()
"
`;

