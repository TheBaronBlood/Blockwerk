exports[`SPIKE-Import: Projekte der AG > M3 Bug-Jagd - Der Roboter ignoriert die Wand: vollständig übersetzt, gültiges Python 1`] = `
"from pybricks.hubs import PrimeHub
from pybricks.parameters import Direction, Port
from pybricks.pupdevices import Motor, UltrasonicSensor
from pybricks.robotics import DriveBase

hub = PrimeHub()

# Geräte an den Anschlüssen
motor_A = Motor(Port.A, Direction.COUNTERCLOCKWISE)
motor_B = Motor(Port.B)
abstand_D = UltrasonicSensor(Port.D)

# Fahrbasis
roboter = DriveBase(motor_A, motor_B, wheel_diameter=56, axle_track=112)
roboter.use_gyro(True)

roboter.settings(straight_speed=145, turn_rate=150)
roboter.drive(145, 0)
if abstand_D.distance() < 100:
    roboter.brake()
"
`;

