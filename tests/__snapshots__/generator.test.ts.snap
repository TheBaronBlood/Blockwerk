exports[`Beispiele > gleichzeitig: erzeugter Code bleibt stabil 1`] = `
"from pybricks.hubs import PrimeHub
from pybricks.parameters import Button, Direction, Icon, Port
from pybricks.pupdevices import Motor
from pybricks.robotics import DriveBase
from pybricks.tools import wait, multitask, run_task

hub = PrimeHub()

# Geräte an den Anschlüssen
motor_A = Motor(Port.A, Direction.COUNTERCLOCKWISE)
motor_B = Motor(Port.B)

# Fahrbasis
roboter = DriveBase(motor_A, motor_B, wheel_diameter=56, axle_track=112)
roboter.use_gyro(True)

# Nachrichten zwischen den Programmteilen: wie oft welche gesendet wurde
nachrichten = {}

def sende(name):
    nachrichten[name] = nachrichten.get(name, 0) + 1

async def warte_auf(name):
    stand = nachrichten.get(name, 0)
    while nachrichten.get(name, 0) == stand:
        await wait(10)

async def start():
    while True:
        await roboter.straight(200)
        await roboter.turn(90)

async def ereignis():
    while True:
        while not (Button.LEFT in hub.buttons.pressed()):
            await wait(10)
        await hub.speaker.beep(880, 200)
        sende('lachen')
        while Button.LEFT in hub.buttons.pressed():
            await wait(10)

async def nachricht_lachen():
    while True:
        await warte_auf('lachen')
        hub.display.icon(Icon.HAPPY)
        await wait(1000)
        hub.display.off()

# Alle Programmteile gleichzeitig starten
run_task(multitask(nachricht_lachen(), start(), ereignis()))
"
`;

