exports[`Beispiele > steuerfeld: erzeugter Code bleibt stabil 1`] = `
"from pybricks.hubs import PrimeHub
from pybricks.parameters import Direction, Port
from pybricks.pupdevices import Motor
from pybricks.robotics import DriveBase
from pybricks.tools import wait, read_input_byte, StopWatch

hub = PrimeHub()

# Geräte an den Anschlüssen
motor_A = Motor(Port.A, Direction.COUNTERCLOCKWISE)
motor_B = Motor(Port.B)

# Fahrbasis
roboter = DriveBase(motor_A, motor_B, wheel_diameter=56, axle_track=112)
roboter.use_gyro(True)

# Steuerfeld von Blockwerk: Eingaben kommen als einzelne Bytes vom Browser
steuerfeld = {'x': 0, 'y': 0, 'A': False, 'B': False, 'C': False, 'D': False}
steuerfeld_uhr = StopWatch()

def steuerung(name):
    while True:
        byte = read_input_byte()
        if byte is None:
            break
        steuerfeld_uhr.reset()
        if 150 <= byte <= 170:
            steuerfeld['x'] = (byte - 160) * 10
        elif 180 <= byte <= 200:
            steuerfeld['y'] = (byte - 190) * 10
        elif 65 <= byte <= 68:
            steuerfeld[chr(byte)] = True
        elif 97 <= byte <= 100:
            steuerfeld[chr(byte - 32)] = False
    # Funkstille: Verbindung weg, also alles loslassen
    if steuerfeld_uhr.time() > 1000:
        steuerfeld.update(x=0, y=0, A=False, B=False, C=False, D=False)
    return steuerfeld[name]

while True:
    roboter.drive(steuerung('y') * 3, steuerung('x') * 2)
    if steuerung('A'):
        hub.speaker.beep(880, 100)
    wait(20)
"
`;

exports[`Beispiele > wand: erzeugter Code bleibt stabil 1`] = `
"from pybricks.hubs import PrimeHub
from pybricks.parameters import Direction, Icon, Port
from pybricks.pupdevices import ForceSensor, Motor, UltrasonicSensor
from pybricks.robotics import DriveBase
from pybricks.tools import wait

hub = PrimeHub()

# Geräte an den Anschlüssen
motor_A = Motor(Port.A, Direction.COUNTERCLOCKWISE)
motor_B = Motor(Port.B)
abstand_D = UltrasonicSensor(Port.D)
kraft_E = ForceSensor(Port.E)

# Fahrbasis
roboter = DriveBase(motor_A, motor_B, wheel_diameter=56, axle_track=112)
roboter.use_gyro(True)

hub.display.icon(Icon.ARROW_UP)
while not kraft_E.pressed():
    wait(10)
roboter.drive(150, 0)
while not (abstand_D.distance() < 100):
    wait(10)
roboter.brake()
hub.display.icon(Icon.HAPPY)
"
`;

exports[`Beispiele > zaehlen: erzeugter Code bleibt stabil 1`] = `
"from pybricks.hubs import PrimeHub
from pybricks.parameters import Direction, Port
from pybricks.pupdevices import ColorSensor, Motor
from pybricks.robotics import DriveBase
from pybricks.tools import wait

hub = PrimeHub()

# Geräte an den Anschlüssen
motor_A = Motor(Port.A, Direction.COUNTERCLOCKWISE)
motor_B = Motor(Port.B)
farbe_C = ColorSensor(Port.C)

# Fahrbasis
roboter = DriveBase(motor_A, motor_B, wheel_diameter=56, axle_track=112)
roboter.use_gyro(True)

# Variablen anlegen
Linien = 0

Linien = 0
roboter.drive(120, 0)
while True:
    while not (farbe_C.reflection() < 30):
        wait(10)
    Linien = Linien + 1
    hub.display.number(Linien)
    while not (farbe_C.reflection() > 60):
        wait(10)
"
`;
